# Hospital AI - Environment Configuration Template
# Copy this file to `.env` (gitignored) and replace every CHANGE_ME_* value with strong secrets before running Docker Compose or Production services.

# SQL Server
SQL_SA_PASSWORD=CHANGE_ME_StrongSqlPassword_123!

# MongoDB (AI Audit Logs)
MONGO_INITDB_ROOT_USERNAME=hospitalai_admin
MONGO_INITDB_ROOT_PASSWORD=CHANGE_ME_StrongMongoPassword_123!

# JWT & Cryptography
JWT_SECRET_KEY=CHANGE_ME_GenerateAtLeast32RandomCharactersForJwtSigningKey_2026
DIGITAL_SIGNATURE_SECRET=CHANGE_ME_GenerateAtLeast32RandomCharactersForEmrHmacKey_2026

# OAuth & External Providers
GOOGLE_CLIENT_ID=CHANGE_ME_GoogleOAuthClientId.apps.googleusercontent.com
GEMINI_API_KEY=CHANGE_ME_GeminiApiKey

# VNPay Payment Gateway (Sandbox / Production)
VNPAY_TMN_CODE=CHANGE_ME_TmnCode
VNPAY_HASH_SECRET=CHANGE_ME_VnpayHashSecret
VNPAY_BASE_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=https://dmedical.site/api/payment/vnpay-return

# SePay VietQR Webhook & Bank Account (Sandbox / Live - NEVER put real secret into Git)
SEPAY_ENVIRONMENT=Sandbox
SEPAY_BANK_CODE=MB
SEPAY_BANK_BIN=970422
SEPAY_ACCOUNT_NUMBER=0000000001
SEPAY_ACCOUNT_NAME=HOSPITAL AI DEMO
SEPAY_PAYMENT_PREFIX=HAI
SEPAY_WEBHOOK_SECRET=CHANGE_ME_SepayWebhookHmacSecret
SEPAY_TIMESTAMP_TOLERANCE_SECONDS=3600

# Smart Kiosk Terminals (Configure unique per-terminal secrets, never reuse defaults)
KIOSK_SECRET_A01=CHANGE_ME_KioskSecretA01
KIOSK_SECRET_B02=CHANGE_ME_KioskSecretB02
KIOSK_SECRET_C03=CHANGE_ME_KioskSecretC03

# Optional Initial Seeding Password (Only used when empty DB is seeded)
SEED_DEFAULT_PASSWORD=CHANGE_ME_InitialSeedPassword@2026
