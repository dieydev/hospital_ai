{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "auth-route": {
        "ClusterId": "auth-cluster",
        "Match": {
          "Path": "/api/auth/{**catch-all}"
        }
      },
      "patients-route": {
        "ClusterId": "patient-cluster",
        "Match": {
          "Path": "/api/patients/{**catch-all}"
        }
      },
      "queue-route": {
        "ClusterId": "queue-cluster",
        "Match": {
          "Path": "/api/queue/{**catch-all}"
        }
      },
      "queue-exact": {
        "ClusterId": "queue-cluster",
        "Match": {
          "Path": "/api/queue"
        }
      },
      "appointments-route": {
        "ClusterId": "queue-cluster",
        "Match": {
          "Path": "/api/appointments/{**catch-all}"
        }
      },
      "appointments-exact": {
        "ClusterId": "queue-cluster",
        "Match": {
          "Path": "/api/appointments"
        }
      },
      "queue-hub-route": {
        "ClusterId": "queue-cluster",
        "Match": {
          "Path": "/hubs/queue/{**catch-all}"
        }
      },
      "queue-hub-exact": {
        "ClusterId": "queue-cluster",
        "Match": {
          "Path": "/hubs/queue"
        }
      },
      "examinations-route": {
        "ClusterId": "examination-cluster",
        "Match": {
          "Path": "/api/examinations/{**catch-all}"
        }
      },
      "ailogs-route": {
        "ClusterId": "examination-cluster",
        "Match": {
          "Path": "/api/ailogs/{**catch-all}"
        }
      },
      "billing-route": {
        "ClusterId": "examination-cluster",
        "Match": {
          "Path": "/api/billing/{**catch-all}"
        }
      },
      "payment-route": {
        "ClusterId": "examination-cluster",
        "Match": {
          "Path": "/api/payment/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "auth-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://identity-service:5001/"
          }
        }
      },
      "patient-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://patient-service:5002/"
          }
        }
      },
      "queue-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://queue-service:5003/"
          }
        }
      },
      "examination-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://examination-service:5004/"
          }
        }
      }
    }
  }
}
